[Unit]
Description=FarReach Radio Streaming Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/music_stream_server/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/music_stream_server/.env
ExecStart=/root/music_stream_server/current/venv/bin/python /root/music_stream_server/current/radio.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
